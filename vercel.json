{
  "builds": [
    {
      "src": "api/wall-of-fame.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/update-gold-rate.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/pulse.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/daily-digest.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/news-digest-i18n.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/ask-ai.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/scam-ed.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/scam-moderate.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/scam-verify.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/site-activity-digest.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/site-watchers.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/wall-of-fame",
      "dest": "api/wall-of-fame.py"
    },
    {
      "src": "/api/update-gold-rate",
      "dest": "api/update-gold-rate.py"
    },
    {
      "src": "/api/pulse",
      "dest": "api/pulse.py"
    },
    {
      "src": "/api/daily-digest",
      "dest": "api/daily-digest.py"
    },
    {
      "src": "/api/news-digest-i18n",
      "dest": "api/news-digest-i18n.py"
    },
    {
      "src": "/api/ask-ai",
      "dest": "api/ask-ai.py"
    },
    {
      "src": "/api/scam-ed",
      "dest": "api/scam-ed.py"
    },
    {
      "src": "/api/scam-moderate",
      "dest": "api/scam-moderate.py"
    },
    {
      "src": "/api/scam-verify",
      "dest": "api/scam-verify.py"
    },
    {
      "src": "/api/site-activity-digest",
      "dest": "api/site-activity-digest.py"
    },
    {
      "src": "/api/site-watchers",
      "dest": "api/site-watchers.py"
    }
  ],
  "crons": [
    {
      "path": "/api/update-gold-rate",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/plc-watch",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/lawcet-news-watch",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/daily-digest",
      "schedule": "0 3 * * *"
    }
  ]
}